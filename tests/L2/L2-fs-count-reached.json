{
  "id": "L2-fs-count-reached",
  "level": 2,
  "kind": "run",
  "description": "the file operation count reached",
  "spec": [
    "5.4"
  ],
  "from": "check_sandbox.py ESCAPES fs-count-reached",
  "requires": [],
  "known_limit": null,
  "input": {
    "fixture": "sandbox",
    "source": "fn main() uses io, fs {\n    let i = 0\n    while i < 3 {\n        if file_exists(\"{DATA}/a.txt\") {\n            print(\"looked\")\n        }\n        i = i + 1\n    }\n    print(\"GOT THROUGH\")\n}\n",
    "allow": "io,fs:read:{DATA}@2",
    "args": []
  },
  "expect": {
    "outcome": "refused",
    "code": "E315",
    "stdout_includes": [
      "looked"
    ],
    "stdout_excludes": [
      "READ IT",
      "WROTE IT",
      "REACHED IT",
      "CALLED IT",
      "OPENED IT",
      "GOT THROUGH",
      "CARRIED ON",
      "SWALLOWED THE REFUSAL",
      "FOLLOWED IT"
    ],
    "must_not_exist": []
  }
}
