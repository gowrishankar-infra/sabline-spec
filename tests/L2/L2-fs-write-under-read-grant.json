{
  "id": "L2-fs-write-under-read-grant",
  "level": 2,
  "kind": "run",
  "description": "writing with only read granted",
  "spec": [
    "5.1"
  ],
  "from": "check_sandbox.py ESCAPES fs-write-under-read-grant",
  "requires": [],
  "known_limit": null,
  "input": {
    "fixture": "sandbox",
    "source": "fn main() uses io, fs {\n    write_file(\"{DATA}/new.txt\", \"escaped\")\n    print(\"WROTE IT\")\n}\n",
    "allow": "io,fs:read:{DATA}",
    "args": []
  },
  "expect": {
    "outcome": "refused",
    "code": "E313",
    "stdout_includes": [],
    "stdout_excludes": [
      "READ IT",
      "WROTE IT",
      "REACHED IT",
      "CALLED IT",
      "OPENED IT",
      "GOT THROUGH",
      "CARRIED ON",
      "SWALLOWED THE REFUSAL",
      "FOLLOWED IT"
    ],
    "must_not_exist": [
      "{DATA}/new.txt"
    ]
  }
}
