{
  "id": "L1-audit-secret-kept",
  "level": 1,
  "kind": "audit",
  "description": "a program that reads the environment holds a Secret: the audit names env as its source and says it never declassifies",
  "spec": [
    "3.2",
    "8"
  ],
  "from": "check_library.py AUDITS secret-kept",
  "requires": [],
  "known_limit": null,
  "input": {
    "files": {
      "main.vel": "fn main() uses io, env {\n    let key = env(\"API_KEY\", \"\")\n    if key == \"\" {\n        print(\"not set\")\n    }\n}\n"
    },
    "entry": "main.vel"
  },
  "expect": {
    "ok": true,
    "effects": [
      "env",
      "io"
    ],
    "functions": [
      {
        "name": "main",
        "effects": [
          "env",
          "io"
        ],
        "can_fail": false
      }
    ],
    "ffi_modules": [],
    "ffi_any": false,
    "fs_paths": {
      "read": [],
      "write": [],
      "read_any": false,
      "write_any": false
    },
    "net_hosts": {
      "hosts": [],
      "any": false
    },
    "safe_command": "velaris <file> --allow env,io",
    "secrets": {
      "sources": [
        "env"
      ],
      "declassifies": false,
      "declassifications": []
    }
  }
}
