{
  "id": "L1-audit-library-without-main",
  "level": 1,
  "kind": "audit",
  "description": "a file with no main is audited as a library, and is not a problem",
  "spec": [
    "3.2",
    "8"
  ],
  "from": "check_library.py AUDITS library-without-main",
  "requires": [],
  "known_limit": null,
  "input": {
    "files": {
      "lib.vel": "fn ping() -> Int uses net or fail {\n    return try fetch_status(\"https://status.example.org\")\n}\n\nfn twice(n: Int) -> Int {\n    return n * 2\n}\n"
    },
    "entry": "lib.vel"
  },
  "expect": {
    "ok": true,
    "effects": [
      "net"
    ],
    "functions": [
      {
        "name": "ping",
        "effects": [
          "net"
        ],
        "can_fail": true
      },
      {
        "name": "twice",
        "effects": [],
        "can_fail": false
      }
    ],
    "ffi_modules": [],
    "ffi_any": false,
    "fs_paths": {
      "read": [],
      "write": [],
      "read_any": false,
      "write_any": false
    },
    "net_hosts": {
      "hosts": [
        "status.example.org"
      ],
      "any": false
    },
    "safe_command": "sabline <file> --allow net:status.example.org"
  }
}
