{
  "id": "L1-audit-secret-declassified",
  "level": 1,
  "kind": "audit",
  "description": "a program that declassifies says so, with the reason written in the call and the function it is in; declassify is an effect, so a budget can refuse it",
  "spec": [
    "3.2",
    "8"
  ],
  "from": "check_library.py AUDITS secret-declassified",
  "requires": [],
  "known_limit": null,
  "input": {
    "files": {
      "main.vel": "fn main() uses io, env, declassify {\n    let region = env(\"REGION\", \"unset\")\n    print(declassify(region, \"a region is not a secret\"))\n}\n"
    },
    "entry": "main.vel"
  },
  "expect": {
    "ok": true,
    "effects": [
      "declassify",
      "env",
      "io"
    ],
    "functions": [
      {
        "name": "main",
        "effects": [
          "declassify",
          "env",
          "io"
        ],
        "can_fail": false
      }
    ],
    "ffi_modules": [],
    "ffi_any": false,
    "fs_paths": {
      "read": [],
      "write": [],
      "read_any": false,
      "write_any": false
    },
    "net_hosts": {
      "hosts": [],
      "any": false
    },
    "safe_command": "sabline <file> --allow declassify,env,io",
    "secrets": {
      "sources": [
        "env"
      ],
      "declassifies": true,
      "declassifications": [
        {
          "reason": "a region is not a secret",
          "function": "main",
          "line": 3
        }
      ]
    }
  }
}
