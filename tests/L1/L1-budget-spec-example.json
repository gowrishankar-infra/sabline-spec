{
  "id": "L1-budget-spec-example",
  "level": 1,
  "kind": "budget",
  "description": "the example of sabline-spec 4: a path, a host with a port, and a count",
  "spec": [
    "4",
    "5"
  ],
  "from": "check_library.py BUDGETS spec-example",
  "requires": [],
  "known_limit": null,
  "input": {
    "allow": "io,fs:read:./data,net:api.example.com:443@100"
  },
  "expect": {
    "valid": true,
    "grants": {
      "effects": [
        "fs",
        "io",
        "net"
      ],
      "fs": [
        {
          "direction": "read",
          "path": "./data"
        }
      ],
      "net": [
        {
          "host": "api.example.com",
          "port": 443
        }
      ],
      "counts": {
        "net": 100
      }
    }
  }
}
