    given-names: Gowri shankar
repository-code: "https://github.com/gowrishankar-infra/velaris-spec"
license: CC0-1.0
version: "0.5"
date-released: "2026-09-11"
keywords:
  - specification
  - effect system
  - capabilities
  - conformance
  - in-toto
references:
